# Public Website & Release Configuration (Cloudflare Pages Environment Variables)
# IMPORTANT: Only public, non-secret values belong in VITE_* variables.
# NEVER put Supabase service-role keys, Render backend secrets, or OAuth client secrets here.

# Canonical public website URL (no trailing slash), e.g. https://penfightaurawars.com
VITE_SITE_URL=""

# Publisher / Developer identity shown in footer and legal pages
VITE_PUBLISHER_NAME="Pen Fight Aura Wars Developer"

# Official player support & privacy contact email
VITE_SUPPORT_EMAIL="manasvig43@gmail.com"

# Google Play Store listing configuration
# Set VITE_PLAY_STORE_LIVE="true" ONLY after com.penfightroyale.game is live on Google Play
VITE_PLAY_STORE_LIVE="false"
VITE_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.penfightroyale.game"

# Optional override for the signed APK bundled in public/downloads/
# Provide a trusted HTTPS URL or a static path under /downloads/ (e.g. /downloads/pen-fight-aura-wars-v1.0.0-release.apk)
# NEVER point this to a debug APK, unsigned APK, or .aab bundle.
VITE_APK_URL=""
VITE_APK_VERSION=""
VITE_APK_RELEASE_DATE=""
VITE_APK_FILE_SIZE=""
VITE_APK_SHA256=""
VITE_MIN_ANDROID_VERSION=""

# Set to "false" to show the online maintenance/availability message.
VITE_ONLINE_MULTIPLAYER_LIVE="true"

# Optional legal metadata overrides (YYYY-MM-DD or readable date)
VITE_LEGAL_EFFECTIVE_DATE=""
VITE_LEGAL_LAST_UPDATED=""
VITE_DELETION_TIMEFRAME=""

# Optional gameplay trailer embed URL (HTTPS YouTube embed or direct MP4 URL)
VITE_TRAILER_URL=""
