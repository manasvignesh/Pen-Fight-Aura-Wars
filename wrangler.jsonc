{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pen-fight-aura-wars",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
